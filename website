<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Codex Agent Demo</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
      font-family: "Poppins", sans-serif;
    }

    body {
      background: #f6f9fc;
      color: #333;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
      transition: background 0.3s, color 0.3s;
    }

    .login-page {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      background: linear-gradient(135deg, #0a2540 0%, #1b3b6f 100%);
    }

    .login-card {
      background: #ffffff;
      border-radius: 12px;
      padding: 40px;
      width: 100%;
      max-width: 420px;
      box-shadow: 0 24px 60px rgba(10, 37, 64, 0.25);
      text-align: center;
      transition: background 0.3s, color 0.3s, transform 0.3s;
    }

    .login-card:hover {
      transform: translateY(-4px);
    }

    .login-card h1 {
      font-size: 2rem;
      margin-bottom: 12px;
      color: #0a2540;
    }

    .login-card p {
      margin-bottom: 22px;
      color: #4a5568;
    }

    .login-card form {
      text-align: left;
    }

    .login-card label {
      display: block;
      font-weight: 600;
      margin-top: 18px;
      color: #0a2540;
    }

    .login-card input {
      width: 100%;
      margin-top: 8px;
      padding: 12px 14px;
      border-radius: 8px;
      border: 1px solid #cbd5e0;
      outline: none;
      transition: border 0.2s, box-shadow 0.2s;
    }

    .login-card input:focus {
      border-color: #0a2540;
      box-shadow: 0 0 0 3px rgba(10, 37, 64, 0.2);
    }

    .login-card button {
      margin-top: 26px;
      width: 100%;
      padding: 12px 16px;
      border: none;
      border-radius: 8px;
      background: #0a2540;
      color: #fff;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.3s, transform 0.2s;
    }

    .login-card button:hover {
      background: #004080;
      transform: translateY(-1px);
    }

    .login-card .hint {
      margin-top: 12px;
      font-size: 0.85rem;
      color: #556987;
      text-align: center;
    }

    .login-message {
      min-height: 18px;
      margin-top: 14px;
      font-size: 0.9rem;
      text-align: center;
    }

    .app-shell {
      flex: 1;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    header {
      padding: 30px 20px 36px;
      background: #0a2540;
      color: #fff;
    }

    .header-bar {
      max-width: 960px;
      margin: 0 auto;
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    .brand h1 {
      font-size: 2rem;
      margin-bottom: 6px;
    }

    .brand p {
      font-size: 0.95rem;
      color: #d2d9e5;
    }

    .header-controls {
      display: flex;
      flex-direction: column;
      gap: 16px;
      align-items: flex-start;
    }

    .primary-nav {
      width: 100%;
    }

    .menu-toggle {
      padding: 10px 16px;
      border-radius: 8px;
      border: 1px solid #ffffff40;
      background: #ffffff22;
      color: inherit;
      cursor: pointer;
      font-weight: 600;
      display: inline-flex;
      align-items: center;
      gap: 8px;
      transition: background 0.3s, border 0.3s;
    }

    .menu-toggle:hover {
      background: #ffffff33;
      border-color: #ffffff55;
    }

    .nav-links {
      list-style: none;
      margin-top: 12px;
      display: none;
      flex-direction: column;
      gap: 10px;
      padding: 12px 16px;
      border-radius: 12px;
      background: #ffffff12;
    }

    .nav-links.open {
      display: flex;
    }

    .nav-links a {
      color: #fff;
      text-decoration: none;
      font-weight: 500;
      padding: 8px 0;
      display: block;
      border-bottom: 1px solid transparent;
      transition: border 0.3s;
    }

    .nav-links li:last-child a {
      border-bottom: none;
    }

    .nav-links a:hover,
    .nav-links a:focus {
      border-color: #4fd1c5;
    }

    #theme-toggle {
      align-self: flex-start;
      padding: 8px 18px;
      border: none;
      border-radius: 999px;
      background: #ffffff1f;
      color: white;
      cursor: pointer;
      transition: background 0.3s;
    }

    #theme-toggle:hover {
      background: #ffffff33;
    }

    .info-panels {
      display: grid;
      gap: 20px;
      width: 100%;
      max-width: 960px;
      margin: 30px auto 0;
      padding: 0 20px;
    }

    .info-card {
      background: #fff;
      color: #0a2540;
      border-radius: 12px;
      padding: 20px;
      box-shadow: 0 16px 30px rgba(10, 37, 64, 0.1);
      transition: transform 0.3s, box-shadow 0.3s;
    }

    .info-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 22px 40px rgba(10, 37, 64, 0.15);
    }

    .info-card h2 {
      margin-bottom: 10px;
      font-size: 1.3rem;
    }

    .info-card p {
      line-height: 1.5;
      color: #334155;
    }

    @media (min-width: 768px) {
      .header-bar {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
      }

      .header-controls {
        flex-direction: row;
        align-items: center;
        gap: 20px;
      }

      .primary-nav {
        display: flex;
        align-items: center;
        gap: 24px;
      }

      .menu-toggle {
        display: none;
      }

      .nav-links {
        display: flex;
        flex-direction: row;
        gap: 24px;
        margin: 0;
        padding: 0;
        background: transparent;
        border: none;
      }

      .nav-links a {
        padding: 0;
        border-bottom: 2px solid transparent;
      }

      .nav-links li:last-child a {
        border-bottom: 2px solid transparent;
      }

      #theme-toggle {
        align-self: center;
      }

      .info-panels {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    .chat-section {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 40px 20px 20px;
    }

    .chat-box {
      width: 90%;
      max-width: 600px;
      height: 400px;
      background: #fff;
      border-radius: 10px;
      box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
      padding: 15px;
      overflow-y: auto;
      transition: background 0.3s;
    }

    .bot-msg,
    .user-msg {
      margin: 10px 0;
      padding: 10px 15px;
      border-radius: 10px;
      max-width: 80%;
    }

    .bot-msg {
      background: #e8f0fe;
      align-self: flex-start;
    }

    .user-msg {
      background: #d1f7c4;
      align-self: flex-end;
      text-align: right;
    }

    .input-area {
      width: 90%;
      max-width: 600px;
      display: flex;
      margin-top: 15px;
    }

    .input-area input {
      flex: 1;
      padding: 10px;
      border: 1px solid #ccc;
      border-radius: 10px 0 0 10px;
      outline: none;
    }

    .input-area button {
      padding: 10px 20px;
      border: none;
      background: #0a2540;
      color: white;
      border-radius: 0 10px 10px 0;
      cursor: pointer;
      transition: 0.3s;
    }

    .input-area button:hover {
      background: #004080;
    }

    footer {
      text-align: center;
      padding: 10px;
      background: #0a2540;
      color: white;
      font-size: 0.9rem;
    }

    .hidden {
      display: none !important;
    }

    /* DARK MODE */
    body.dark {
      background: #0d1117;
      color: #e6edf3;
    }

    body.dark header {
      background: #161b22;
    }

    body.dark .brand p {
      color: #9da7bb;
    }

    body.dark .menu-toggle {
      border-color: #30363d;
      background: #30363d;
    }

    body.dark .menu-toggle:hover {
      background: #3a4557;
      border-color: #3a4557;
    }

    body.dark .nav-links a {
      color: #e6edf3;
    }

    body.dark .nav-links a:hover,
    body.dark .nav-links a:focus {
      border-color: #58a6ff;
    }

    body.dark .nav-links {
      background: #0d1117;
      border: 1px solid #30363d;
    }

    body.dark #theme-toggle {
      background: #238636;
    }

    body.dark #theme-toggle:hover {
      background: #2ea043;
    }

    body.dark .info-card {
      background: #161b22;
      color: #e6edf3;
      box-shadow: 0 18px 36px rgba(2, 6, 23, 0.45);
    }

    body.dark .info-card p {
      color: #9da7bb;
    }

    body.dark .chat-box {
      background: #161b22;
    }

    body.dark .bot-msg {
      background: #21262d;
    }

    body.dark .user-msg {
      background: #2ea043;
      color: white;
    }

    body.dark footer {
      background: #161b22;
    }

    body.dark .login-page {
      background: linear-gradient(135deg, #0d1117 0%, #1f2937 100%);
    }

    body.dark .login-card {
      background: #161b22;
      color: #e6edf3;
      box-shadow: 0 24px 60px rgba(2, 6, 23, 0.55);
    }

    body.dark .login-card p,
    body.dark .login-card label,
    body.dark .login-card .hint {
      color: #c9d1d9;
    }

    body.dark .login-card input {
      background: #0d1117;
      border: 1px solid #30363d;
      color: #e6edf3;
    }

    body.dark .login-card input:focus {
      border-color: #2ea043;
      box-shadow: 0 0 0 3px rgba(46, 160, 67, 0.25);
    }

    body.dark .login-card button {
      background: #2ea043;
    }

    body.dark .login-card button:hover {
      background: #3fb950;
    }
  </style>
</head>
<body>
  <section id="login-page" class="login-page" aria-labelledby="login-title">
    <div class="login-card" role="dialog" aria-modal="true">
      <h1 id="login-title">Welcome back</h1>
      <p>Sign in to access your Codex Agent workspace.</p>
      <form id="login-form" novalidate>
        <label for="username">Username</label>
        <input
          type="text"
          id="username"
          name="username"
          autocomplete="username"
          required
          placeholder="Enter your username"
        />

        <label for="password">Password</label>
        <input
          type="password"
          id="password"
          name="password"
          autocomplete="current-password"
          required
          placeholder="Enter your password"
        />

        <button type="submit" id="login-submit">Log in</button>
        <p class="hint">
          Demo credentials: <strong>demo</strong> / <strong>codex123</strong>
        </p>
        <div id="login-message" class="login-message" role="status" aria-live="polite"></div>
      </form>
    </div>
  </section>

  <div id="app-shell" class="app-shell hidden" aria-hidden="true">
    <header>
      <div class="header-bar">
        <div class="brand">
          <h1>🤖 Codex Agent</h1>
          <p>Explore the power of AI automation — built for developers & creators.</p>
        </div>
        <div class="header-controls">
          <nav class="primary-nav" aria-label="Main navigation">
            <button id="menu-toggle" class="menu-toggle" aria-expanded="false" aria-controls="nav-links">
              ☰ Menu
            </button>
            <ul id="nav-links" class="nav-links">
              <li><a href="#overview">Overview</a></li>
              <li><a href="#features">Features</a></li>
              <li><a href="#support">Support</a></li>
            </ul>
          </nav>
          <button id="theme-toggle">🌙 Dark Mode</button>
        </div>
      </div>
    </header>

    <main>
      <section id="overview" class="info-panels">
        <article class="info-card">
          <h2>Overview</h2>
          <p>
            Move fast with a conversational agent that understands context, automates
            workflows, and keeps your projects humming without endless busywork.
          </p>
        </article>
        <article id="features" class="info-card">
          <h2>Features</h2>
          <p>
            Built-in prompts, reusable templates, and live integrations help you orchestrate
            deployments, triage issues, and surface insights in seconds.
          </p>
        </article>
        <article id="support" class="info-card">
          <h2>Support</h2>
          <p>
            Need a hand? Jump into the chat below to get guided responses, curated resources,
            and personalized follow-ups from your Codex Agent.
          </p>
        </article>
      </section>

      <section class="chat-section">
        <div id="chat-box" class="chat-box" aria-live="polite">
          <div class="bot-msg">👋 Hi there! I'm Codex Agent. How can I assist you today?</div>
        </div>

        <div class="input-area">
          <input type="text" id="user-input" placeholder="Type your message..." aria-label="Message" />
          <button id="send-btn">Send</button>
        </div>
      </section>
    </main>

    <footer>
      <p>© 2025 Codex Agent | Built by PROITBRIDGE</p>
    </footer>
  </div>

  <script>
    const chatBox = document.getElementById("chat-box");
    const userInput = document.getElementById("user-input");
    const sendBtn = document.getElementById("send-btn");
    const themeToggle = document.getElementById("theme-toggle");
    const menuToggle = document.getElementById("menu-toggle");
    const navLinks = document.getElementById("nav-links");
    const loginPage = document.getElementById("login-page");
    const appShell = document.getElementById("app-shell");
    const loginForm = document.getElementById("login-form");
    const loginMessage = document.getElementById("login-message");
    const loginSubmit = document.getElementById("login-submit");
    const usernameInput = document.getElementById("username");
    const passwordInput = document.getElementById("password");

    const VALID_CREDENTIALS = { username: "demo", password: "codex123" };

    // Disable chat interaction until the user logs in.
    sendBtn.disabled = true;
    userInput.disabled = true;

    sendBtn.addEventListener("click", sendMessage);
    userInput.addEventListener("keypress", function (e) {
      if (e.key === "Enter") sendMessage();
    });

    loginForm.addEventListener("submit", function (event) {
      event.preventDefault();
      handleLogin();
    });

    function handleLogin() {
      const username = usernameInput.value.trim();
      const password = passwordInput.value;

      loginMessage.textContent = "";

      if (!username || !password) {
        loginMessage.style.color = "#c53030";
        loginMessage.textContent = "Please fill in both fields to continue.";
        return;
      }

      loginSubmit.disabled = true;
      loginSubmit.textContent = "Signing in...";

      setTimeout(() => {
        const isValid =
          username.toLowerCase() === VALID_CREDENTIALS.username &&
          password === VALID_CREDENTIALS.password;

        if (isValid) {
          loginMessage.style.color = "#2ea043";
          loginMessage.textContent = "Success! Redirecting to the chat...";
          finalizeLogin();
        } else {
          loginMessage.style.color = "#c53030";
          loginMessage.textContent = "Invalid credentials. Try demo / codex123.";
          loginSubmit.disabled = false;
          loginSubmit.textContent = "Log in";
          passwordInput.focus();
        }
      }, 450);
    }

    function finalizeLogin() {
      sendBtn.disabled = false;
      userInput.disabled = false;
      loginPage.classList.add("hidden");
      loginPage.setAttribute("aria-hidden", "true");
      appShell.classList.remove("hidden");
      appShell.removeAttribute("aria-hidden");
      loginSubmit.textContent = "Log in";
      loginSubmit.disabled = false;
      userInput.focus();

      const welcomeMsg = document.createElement("div");
      welcomeMsg.classList.add("bot-msg");
      welcomeMsg.textContent = "🎉 You're logged in! How can I help you today?";
      chatBox.appendChild(welcomeMsg);
      chatBox.scrollTop = chatBox.scrollHeight;
    }

    function sendMessage() {
      const msg = userInput.value.trim();
      if (!msg) return;

      const userMsg = document.createElement("div");
      userMsg.classList.add("user-msg");
      userMsg.textContent = msg;
      chatBox.appendChild(userMsg);

      setTimeout(() => {
        const botMsg = document.createElement("div");
        botMsg.classList.add("bot-msg");
        botMsg.textContent = generateReply(msg);
        chatBox.appendChild(botMsg);
        chatBox.scrollTop = chatBox.scrollHeight;
      }, 600);

      userInput.value = "";
    }

    function generateReply(input) {
      input = input.toLowerCase();
      if (input.includes("hello") || input.includes("hi"))
        return "Hey there 👋! I'm your Codex Agent — ready to help!";
      if (input.includes("what can you do"))
        return "I can automate workflows, analyze data, and build AI apps. 🚀";
      if (input.includes("bye"))
        return "Goodbye! 👋 Keep exploring with Codex Agent.";
      return "Interesting! Tell me more...";
    }

    themeToggle.addEventListener("click", () => {
      document.body.classList.toggle("dark");
      const isDark = document.body.classList.contains("dark");
      themeToggle.textContent = isDark ? "☀️ Light Mode" : "🌙 Dark Mode";
    });

    if (menuToggle && navLinks) {
      menuToggle.addEventListener("click", () => {
        const isOpen = navLinks.classList.toggle("open");
        menuToggle.setAttribute("aria-expanded", String(isOpen));
      });

      navLinks.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => {
          if (window.innerWidth < 768) {
            navLinks.classList.remove("open");
            menuToggle.setAttribute("aria-expanded", "false");
          }
        });
      });

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 768) {
          navLinks.classList.remove("open");
          menuToggle.setAttribute("aria-expanded", "false");
        }
      });
    }

    // Focus the username field when the login page loads.
    window.addEventListener("load", () => {
      usernameInput.focus();
    });
  </script>
</body>
</html>
